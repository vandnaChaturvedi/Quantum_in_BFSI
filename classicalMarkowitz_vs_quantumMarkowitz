    "# ── Portfolio Statistics Helper ──────────────────────────────────\n",
    "\n",
    "def portfolio_stats(asset_indices):\n",
    "    \"\"\"Compute return, risk, Sharpe, and QUBO objective for a portfolio.\"\"\"\n",
    "    idx = np.array(asset_indices)\n",
    "    k   = len(idx)\n",
    "    ret  = mu[idx].mean()\n",
    "    var  = cov[np.ix_(idx, idx)].sum() / k**2\n",
    "    risk = np.sqrt(var)\n",
    "    sharpe = (ret - 0.02) / risk\n",
    "    obj  = LAMBDA * var - (1 - LAMBDA) * ret   # QUBO objective to minimise\n",
    "    return {\n",
    "        'return':  ret,\n",
    "        'risk':    risk,\n",
    "        'sharpe':  sharpe,\n",
    "        'obj':     obj,\n",
    "        'variance':var,\n",
    "        'tickers': [TICKERS[i] for i in idx]}\n",
    "\n",
    "# ── Convergence Curve Helper ─────────────────────────────────────\n",
    "# make_convergence — it generates a smooth noisy exponential decay curve start → end over n steps. Used to simulate optimization convergence trajectories for plots.\n",
    "\n",
    "def make_convergence(start, end, n=80, noise_scale=0.002, seed=0):\n",
    "    \"\"\"Simulate optimization convergence trajectory.\"\"\"\n",
    "    rq = np.random.default_rng(seed)\n",
    "    t  = np.linspace(0, 1, n)\n",
    "    v  = start + (end - start) * (1 - np.exp(-4 * t))\n",
    "    return v + rq.normal(0, noise_scale, n)"
   ]
